<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="#1E1B24"
    android:padding="16dp">

    <EditText
        android:id="@+id/etTimerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nombre del timer"
        android:textColorHint="#7F7F7F"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@android:color/transparent"
        android:importantForAutofill="no"
        android:inputType="textPersonName"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/etInputMinutes"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:hint="Minutos"
        android:textColorHint="#7F7F7F"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:backgroundTint="#A881F8"
        android:gravity="center"
        android:importantForAutofill="no"
        android:inputType="number"
        android:text="5"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/etTimerTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvTimerClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="05:00"
        android:textColor="#A881F8"
        android:textSize="36sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/etInputMinutes"
        app:layout_constraintBottom_toBottomOf="@id/etInputMinutes"
        app:layout_constraintStart_toEndOf="@id/etInputMinutes" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/etInputMinutes"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnPause"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Iniciar"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#2D2938"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Borrar"
            android:layout_marginStart="4dp"
            android:backgroundTint="#2D2938"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>