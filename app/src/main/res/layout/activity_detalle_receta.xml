<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0B16"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvDetalleTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="Preparación"
        android:textColor="#F5F3FF"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnDetalleBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnDetalleBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#221C38"
        android:text="@string/back"
        android:textColor="#F5F3FF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvDetalleTitle"
        app:layout_constraintBottom_toTopOf="@id/btnGoToTimers">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tvDetalleEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍳"
                android:textSize="80sp"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/tvDetalleRecipeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre de la Receta"
                android:textColor="#A881F8"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/tvDetalleInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aquí van las instrucciones detalladas paso a paso..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.3"
                android:background="#1E1B24"
                android:padding="16dp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnGoToTimers"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="#A881F8"
        android:text="⏱️ Ir a Timers de cocina"
        android:textColor="#0E0B16"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>