<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0B16"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_app_logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auth_register_title"
        android:textColor="#F5F3FF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_search_field"
        android:hint="@string/auth_name_hint"
        android:inputType="textPersonName"
        android:paddingHorizontal="16dp"
        android:textColor="#F5F3FF"
        android:textColorHint="#9892AC" />

    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search_field"
        android:hint="@string/auth_email_hint"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="16dp"
        android:textColor="#F5F3FF"
        android:textColorHint="#9892AC" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search_field"
        android:hint="@string/auth_password_hint"
        android:inputType="textPassword"
        android:paddingHorizontal="16dp"
        android:textColor="#F5F3FF"
        android:textColorHint="#9892AC" />

    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#8B5CF6"
        android:text="@string/auth_register_button" />

    <ProgressBar
        android:id="@+id/progressAuth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvGoLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/auth_go_login"
        android:textColor="#C4B5FD"
        android:textSize="14sp" />
</LinearLayout>
